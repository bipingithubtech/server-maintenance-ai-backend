# LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=openai/gpt-oss-120b
LLM_PROVIDER=groq
TEMPERATURE=0.0

# Microsoft Teams Webhook (Optional)
TEAMS_WEBHOOK_URL=your_teams_webhook_url_here

# GitHub Token (for private repos)
GITHUB_TOKEN=your_github_token_here

# SSH Connection Defaults (optional fallbacks)
# If not provided here, users MUST send credentials via API request
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USERNAME=root
SSH_PASSWORD=
# SSH_KEY_PATH=/path/to/your/.ssh/id_ed25519  # Uncomment and set your SSH key path

# Sudo password for server operations (when passwordless sudo not available)
SUDO_PASSWORD=
